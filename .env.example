# Public deployment origin only; never place secrets in NEXT_PUBLIC_* variables.
# Unset, the site defaults to the canonical custom domain (https://umrndem.com).
# Override for local metadata audits or temporary workers.dev checks.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional contact-mail provider (server-only). Leave unset to keep the
# /api/contact stub mode that validates submissions without sending mail.
# CONTACT_EMAIL_API_KEY=
# CONTACT_INBOX=umrndem@gmail.com
# CONTACT_FROM="Portfolio contact <noreply@your-domain>"
